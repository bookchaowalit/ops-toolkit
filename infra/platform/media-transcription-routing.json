{
  "schema_version": "solo-empire.media-transcription-routing.v1",
  "updated_at": "2026-10-08",
  "description": "Routing contract for remote-URL transcription and summarization. Ranks change as providers improve: edit candidates and own_eval here, never in code.",
  "policy": {
    "max_evaluation_age_days": 90,
    "review_confidence_threshold": 0.6,
    "summary_privacy_class": "internal",
    "external_privacy_classes": [
      "public",
      "internal"
    ],
    "selection_order": "own_eval WER ascending when present, then candidate list order",
    "own_eval_metric": "Thai uses character error rate (cer) because Thai has no word spaces; English uses word error rate (wer). Values are stored in own_eval.wer_pct with own_eval.metric naming the measure."
  },
  "content_kinds": {
    "meeting": {
      "label": "Meeting recording",
      "required_features": [
        "url_input",
        "diarization",
        "word_timestamps"
      ],
      "summary_profile": "meeting-minutes"
    },
    "video_edit": {
      "label": "Raw footage for editing",
      "required_features": [
        "url_input",
        "word_timestamps"
      ],
      "summary_profile": "edit-decision-list"
    },
    "video_content": {
      "label": "Finished or near-finished clip",
      "required_features": [
        "url_input",
        "word_timestamps"
      ],
      "summary_profile": "content-highlights"
    }
  },
  "summary_profiles": {
    "meeting-minutes": {
      "gateway_route": "media-summary-meeting",
      "prompt_version": "meeting-minutes-v1",
      "gateway_profile": "quality",
      "outputs": [
        "minutes",
        "decisions",
        "action_items",
        "open_questions"
      ]
    },
    "edit-decision-list": {
      "gateway_route": "media-summary-edit",
      "prompt_version": "edit-decision-list-v1",
      "gateway_profile": "balanced",
      "outputs": [
        "edl",
        "cut_suggestions",
        "filler_and_silence",
        "chapters"
      ]
    },
    "content-highlights": {
      "gateway_route": "media-summary-content",
      "prompt_version": "content-highlights-v1",
      "gateway_profile": "balanced",
      "outputs": [
        "highlights",
        "short_clip_candidates",
        "title_ideas",
        "description",
        "chapters",
        "subtitles_srt"
      ]
    }
  },
  "stt_routes": {
    "th": [
      "speechmatics-enhanced",
      "azure-speech-batch",
      "elevenlabs-scribe-v2",
      "gladia"
    ],
    "en": [
      "elevenlabs-scribe-v2",
      "assemblyai-universal",
      "deepgram-nova-3",
      "speechmatics-enhanced"
    ],
    "mixed": [
      "gladia",
      "elevenlabs-scribe-v2",
      "speechmatics-enhanced"
    ]
  },
  "providers": {
    "speechmatics-enhanced": {
      "vendor": "speechmatics",
      "model": "enhanced",
      "credential_env": "SPEECHMATICS_API_KEY",
      "languages": [
        "th",
        "en",
        "mixed"
      ],
      "features": [
        "url_input",
        "diarization",
        "word_timestamps",
        "language_detection"
      ],
      "url_input_field": "fetch_data.url",
      "public_evidence": {
        "th_fleurs_wer_pct": 7.37,
        "source": "https://www.speechmatics.com/speech-to-text/thai",
        "quality": "third_party_unverified"
      },
      "pricing": {
        "usd_per_hour": 0.4,
        "free_hours_per_month": 30,
        "source": "https://usagepricing.com/blueprint/activity/speechmatics-2026-07-06-price-change",
        "checked_at": "2026-10-08",
        "quality": "third_party_unverified"
      },
      "own_eval": null
    },
